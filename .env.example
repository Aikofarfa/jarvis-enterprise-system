# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@localhost:3306/jarvis

# AI failover (server-only; never expose these in Expo public variables)
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Planned integrations: enable only after validating ownership, scopes and terms
GOOGLE_MAPS_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NEQUI_WEBHOOK_SECRET=
JARVIS_API_BASE_URL=http://localhost:3000
